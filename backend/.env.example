# ==============================================================================
# JK ENGINEERS & ENTERPRISES - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

# Core Django Security & Debug
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here

# Supabase PostgreSQL Database (Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Host & Origin Security
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://jk-engineers.vercel.app,https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://jk-engineers.vercel.app
CORS_ALLOW_ALL_ORIGINS=True

# Email & Notification Settings
DEFAULT_FROM_EMAIL=noreply@jkengineers.com
CONTACT_RECIPIENT_EMAIL=kandhikanti@yahoo.co.in
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional Live SMTP Email Settings:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
